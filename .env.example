# =============================================================================
# AION Wealth OS — environment configuration (v0.1 founder pilot)
# =============================================================================
# Copy this file to `.env.local` and fill in values for REAL USER MODE.
#
# The app is fully usable WITHOUT any of these set: the clearly-labeled
# synthetic demo runs entirely in the browser and never touches Supabase.
# Missing/partial provider config produces a useful *setup state*, never a
# pretend success.
# -----------------------------------------------------------------------------

# --- Supabase (Auth + Postgres) — required only for REAL USER MODE ---
# Public (safe to expose to the browser):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose to the browser. Used for privileged server actions
# (e.g. authenticated account deletion). Leave blank to disable those paths.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional contextual AI educator — OFF by default ---
# The core loop works fully with AI disabled. Leave blank to keep AI off.
# Provider adapter is server-side only; keys never reach the browser.
AI_PROVIDER=            # e.g. "anthropic" | "" (disabled)
AI_API_KEY=
AI_MODEL=               # e.g. "claude-sonnet-5"
# Spending / rate guardrails (integer cents and integer counts).
AI_MONTHLY_BUDGET_CENTS=500      # hard monthly spend cap, USD cents
AI_RATE_LIMIT_PER_HOUR=20        # max AI requests per user per hour
