# =============================================================================
# AION Wealth OS — environment configuration (v0.1 founder pilot)
# =============================================================================
# Copy this file to `.env.local` and fill in values for REAL USER MODE.
#
# The app is fully usable WITHOUT any of these set: the clearly-labeled
# synthetic demo runs entirely in the browser and never touches Supabase.
# Missing/partial provider config produces a useful *setup state*, never a
# pretend success.
# -----------------------------------------------------------------------------

# --- Supabase (Auth + Postgres) — required only for REAL USER MODE ---
# Public (safe to expose to the browser):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose to the browser. Used ONLY for bank-connection
# records (which users cannot write, and whose token column they cannot read).
# Required for connected accounts; leave blank to keep them off.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional connected accounts (Plaid) — OFF unless all required values are set ---
# All server-only; none is NEXT_PUBLIC_. Set them in Vercel, never in the repo.
PLAID_CLIENT_ID=
PLAID_SECRET=                    # use the secret that matches PLAID_ENV
PLAID_ENV=sandbox                # sandbox | production
# 32 random bytes, base64 (e.g. `openssl rand -base64 32`). Encrypts access
# tokens at rest. Lives outside the database. Changing it makes every stored
# connection unreadable (users would need to reconnect).
PLAID_TOKEN_ENCRYPTION_KEY=
# Public HTTPS URL of /api/plaid/webhook on this deployment (optional; without
# it, figures refresh only when the user taps Refresh).
PLAID_WEBHOOK_URL=
# Needed for OAuth banks (e.g. Chase) in production: https://<host>/plaid/oauth,
# also allow-listed in the Plaid dashboard.
PLAID_REDIRECT_URI=
PLAID_MAX_ITEMS_PER_USER=3        # pilot guard; Plaid's trial plan allows 10 production items

# --- Optional contextual AI educator — OFF by default ---
# The core loop works fully with AI disabled. Leave blank to keep AI off.
# Provider adapter is server-side only; keys never reach the browser.
AI_PROVIDER=            # e.g. "anthropic" | "" (disabled)
AI_API_KEY=
AI_MODEL=               # e.g. "claude-sonnet-5"
# Spending / rate guardrails (integer cents and integer counts).
AI_MONTHLY_BUDGET_CENTS=500      # hard monthly spend cap, USD cents
AI_RATE_LIMIT_PER_HOUR=20        # max AI requests per user per hour
